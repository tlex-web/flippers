{
  "name": "flippers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based pinball with an original space-themed table, procedural rendering, and synthesized audio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "soak": "vitest run --config vitest.gate.config.ts --testTimeout=900000"
  },
  "dependencies": {
    "planck": "1.5.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "^4.1.11"
  }
}
